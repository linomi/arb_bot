 frontend/js/i18n/en.json         |  14 +++-
 frontend/js/i18n/fa.json         |  14 +++-
 frontend/js/main.js              |   5 ++
 tests/test_audit_fixes.py        | 106 ++++++++++++++++++++++++++
 14 files changed, 396 insertions(+), 61 deletions(-)
 create mode 100644 tests/test_audit_fixes.py

