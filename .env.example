# Copy to .env and fill in values, then restart the bot.
#   cp .env.example .env

# Required to save API credentials (Settings → Credentials).
# Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Optional override (default is set in DB system config / UI).
# NOBITEX_BASE_URL=https://apiv2.nobitex.ir
# Testnet:
# NOBITEX_BASE_URL=https://testnetapiv2.nobitex.ir

# ---- Basic authentication (UI + API) ----
# When both are set, the web UI and /api/* require login.
# Session cookie lasts 5 days.
# AUTH_USERNAME=admin
# AUTH_PASSWORD=change-me
# Optional: separate secret for signing the session cookie (defaults to ENCRYPTION_KEY)
# SESSION_SECRET=

# ---- Telegram (optional): notifications + control from your phone ----
# 1. Create a bot with @BotFather and paste its token.
# 2. Send any message to @userinfobot to get YOUR numeric id; put it in TELEGRAM_CHAT_IDS.
#    Only these ids can talk to the bot or receive messages (comma separated).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_IDS=
# Optional PIN that must accompany /confirm for sensitive actions (/closeall, /resume in Live ...)
# TELEGRAM_PIN=
# If Telegram is blocked from the server, route it through a proxy (http://host:port)
# TELEGRAM_PROXY=
# Daily digest time (HH:MM local) or "off"; timezone defaults to Asia/Tehran
# TELEGRAM_DIGEST_TIME=21:00
# TELEGRAM_TZ=Asia/Tehran
