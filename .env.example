# Copy to .env and fill in values, then restart the bot.
#   cp .env.example .env

# Required to save API credentials (Settings → Credentials).
# Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

